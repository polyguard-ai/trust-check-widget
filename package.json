{
  "name": "trust-check-widget",
  "version": "0.1.0",
  "private": true,
  "description": "Replace your CAPTCHA with a Polyguard Trust Check: keyless widget, migration guides and server-side verification examples.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:positioning": "tsx lib/positioning-lint.ts",
    "test:e2e": "playwright test",
    "fetch-widget": "bash scripts/fetch-widget.sh",
    "format": "prettier --write \"{app,components,lib,tests,examples}/**/*.{ts,tsx,js}\" \"*.{ts,mjs,json}\""
  },
  "dependencies": {
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
