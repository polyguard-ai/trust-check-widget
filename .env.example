# =============================================================================
# Browser-exposed (inlined at build time)
# =============================================================================
# Host of the Polyguard API, without a scheme. The widget resolves its link and
# issues tickets at https://<host>, and /api/submit calls
# https://<host>/v2/siteverify. For a local backend, use its ngrok host.
NEXT_PUBLIC_POLYGUARD_API_SERVER=api.polyguard.ai

# Where the widget script is loaded from. For local development against an
# unreleased SDK, run `pnpm fetch-widget` and set this to /vendor/trust-check.js
NEXT_PUBLIC_TRUST_CHECK_SCRIPT_URL=https://cdn.polyguard.ai/sdk/latest/trust-check.js

# =============================================================================
# Server only (never prefix with NEXT_PUBLIC_)
# =============================================================================
# Optional. After the hostname is claimed, the App API key from the console.
# Sent as `secret` to /v2/siteverify. Leave empty for keyless mode.
POLYGUARD_SITEVERIFY_SECRET=

# Optional. Comma-separated hostnames /api/submit accepts in the siteverify
# result. Empty means the hostname of the incoming request.
POLYGUARD_EXPECTED_HOSTNAMES=
